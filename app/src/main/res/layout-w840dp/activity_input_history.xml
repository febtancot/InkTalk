<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal">

    <LinearLayout
        android:layout_width="92dp"
        android:layout_height="match_parent"
        android:background="@color/toolbar_bg"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingTop="18dp"
        android:paddingEnd="8dp">

        <ImageView
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:contentDescription="@null"
            android:scaleType="centerInside"
            android:src="@mipmap/ic_launcher" />

        <TextView
            android:id="@+id/btnHistoryToday"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_icon_button_selected"
            android:contentDescription="@string/history_nav_today_description"
            android:gravity="center"
            android:text="@string/history_nav_today"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btnHistoryHotwords"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_icon_button"
            android:contentDescription="@string/history_nav_hotwords_description"
            android:gravity="center"
            android:text="@string/history_nav_hotwords"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btnHistorySettings"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_icon_button"
            android:contentDescription="@string/history_settings_description"
            android:gravity="center"
            android:text="@string/history_settings"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />
    </LinearLayout>

    <View
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:background="@color/divider_soft" />

    <LinearLayout
        android:layout_width="380dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="18dp"
        android:paddingEnd="18dp"
        android:paddingBottom="18dp">

        <TextView
            style="@style/SettingsHeaderTitle"
            android:text="@string/history_title" />

        <TextView
            style="@style/SettingsHeaderSubtitle"
            android:layout_marginTop="4dp"
            android:text="@string/history_scope_description" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_settings_card"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnPreviousDate"
                android:layout_width="48dp"
                android:layout_height="match_parent"
                android:contentDescription="@string/history_previous_date"
                android:gravity="center"
                android:text="@string/history_previous_symbol"
                android:textColor="@color/icon_primary"
                android:textSize="30sp" />

            <TextView
                android:id="@+id/textHistoryDate"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:contentDescription="@string/history_choose_date"
                android:gravity="center"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnNextDate"
                android:layout_width="48dp"
                android:layout_height="match_parent"
                android:contentDescription="@string/history_next_date"
                android:gravity="center"
                android:text="@string/history_next_symbol"
                android:textColor="@color/icon_primary"
                android:textSize="30sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnToday"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_gravity="end"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_action_chip"
            android:gravity="center"
            android:minWidth="72dp"
            android:text="@string/history_today"
            android:textColor="@color/chip_text"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/textRawHistoryTitle"
            style="@style/SettingsSection"
            android:text="@string/history_raw_title" />

        <TextView
            style="@style/SettingsSectionDescription"
            android:text="@string/history_raw_description" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="24dp">

                <TextView
                    android:id="@+id/textHistoryEmpty"
                    style="@style/SettingsHint"
                    android:text="@string/history_empty" />

                <LinearLayout
                    android:id="@+id/historyEntries"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <View
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:background="@color/divider_soft" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="18dp"
        android:paddingEnd="24dp"
        android:paddingBottom="18dp">

        <TextView
            style="@style/SettingsHeaderTitle"
            android:text="@string/history_workspace_title" />

        <TextView
            style="@style/SettingsHeaderSubtitle"
            android:layout_marginTop="4dp"
            android:text="@string/history_workspace_description" />

        <Button
            android:id="@+id/btnOrganizeDay"
            style="@style/SettingsSecondaryButton"
            android:layout_marginTop="14dp"
            android:drawableStart="@drawable/ic_material_auto_awesome_18"
            android:text="@string/history_organize" />

        <TextView
            android:id="@+id/textHistoryStatus"
            style="@style/SettingsStatus"
            android:visibility="gone" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="24dp">

                <TextView
                    style="@style/SettingsSection"
                    android:text="@string/history_organized_title" />

                <TextView
                    style="@style/SettingsSectionDescription"
                    android:text="@string/history_organization_privacy" />

                <LinearLayout
                    android:id="@+id/organizedCard"
                    style="@style/SettingsCard"
                    android:layout_marginTop="12dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/textOrganizationMeta"
                        style="@style/SettingsFieldDescription"
                        android:layout_marginTop="0dp" />

                    <TextView
                        android:id="@+id/textOrganizationContent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:lineSpacingExtra="4dp"
                        android:textColor="@color/text_primary"
                        android:textIsSelectable="true"
                        android:textSize="15sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/textCandidateSectionTitle"
                    style="@style/SettingsSection"
                    android:text="@string/history_candidate_title"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/textCandidateSectionDescription"
                    style="@style/SettingsSectionDescription"
                    android:text="@string/history_candidate_description"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/historyCandidateContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</LinearLayout>
