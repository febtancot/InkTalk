<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/backupScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="ifContentScrolls"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="18dp"
        android:paddingEnd="20dp"
        android:paddingBottom="48dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnBackupBack"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_icon_button"
                android:contentDescription="@string/backup_back"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_material_arrow_back_24"
                android:tint="@color/icon_primary"
                tools:ignore="UseAppTint" />

            <TextView
                style="@style/SettingsHeaderTitle"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="@string/backup_title" />
        </LinearLayout>

        <TextView
            style="@style/SettingsHeaderSubtitle"
            android:layout_marginTop="6dp"
            android:text="@string/backup_subtitle" />

        <TextView
            style="@style/SettingsSection"
            android:text="@string/settings_backup_section" />

        <TextView
            style="@style/SettingsSectionDescription"
            android:text="@string/settings_backup_description" />

        <LinearLayout style="@style/SettingsCard">

            <TextView
                style="@style/SettingsHint"
                android:layout_marginTop="0dp"
                android:text="@string/settings_backup_sensitive_warning" />

            <Button
                android:id="@+id/btnExportSettings"
                style="@style/SettingsActionButton"
                android:layout_marginTop="12dp"
                android:drawableStart="@drawable/ic_material_save_24"
                android:text="@string/settings_export" />

            <Button
                android:id="@+id/btnImportSettings"
                style="@style/SettingsActionButton"
                android:layout_marginBottom="0dp"
                android:drawableStart="@drawable/ic_material_arrow_down_24"
                android:text="@string/settings_import" />
        </LinearLayout>

        <TextView
            android:id="@+id/textBackupStatus"
            style="@style/SettingsStatus"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
