<?xml version="1.0" encoding="utf-8"?>
<com.inktalk.ime.ui.AdaptiveContentLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="18dp"
    android:paddingEnd="20dp"
    android:paddingBottom="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnHotwordsBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_icon_button"
            android:contentDescription="@string/hotwords_back"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_material_arrow_back_24"
            android:tint="@color/icon_primary"
            tools:ignore="UseAppTint" />

        <TextView
            style="@style/SettingsHeaderTitle"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="@string/hotwords_title" />
    </LinearLayout>

    <TextView
        style="@style/SettingsHeaderSubtitle"
        android:layout_marginTop="6dp"
        android:text="@string/hotwords_subtitle" />

    <TextView
        style="@style/SettingsSection"
        android:layout_marginTop="8dp"
        android:text="@string/hotwords_current_title" />

    <TextView
        style="@style/SettingsHint"
        android:layout_marginTop="4dp"
        android:text="@string/hotwords_editor_help" />

    <TextView
        android:id="@+id/textPendingHotwordCandidates"
        style="@style/SettingsLabel"
        android:text="@string/hotwords_pending_candidates"
        android:visibility="gone" />

    <HorizontalScrollView
        android:id="@+id/pendingHotwordCandidateScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:scrollbars="none"
        android:visibility="gone">
        <LinearLayout
            android:id="@+id/pendingHotwordCandidates"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <TextView
        android:id="@+id/textHotwordCount"
        style="@style/SettingsLabel"
        android:layout_marginTop="12dp"
        tools:text="热词数量：240" />

    <EditText
        android:id="@+id/editHotwordList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_settings_input"
        android:gravity="top|start"
        android:hint="@string/hotwords_editor_hint"
        android:importantForAutofill="no"
        android:inputType="textMultiLine|textNoSuggestions"
        android:minHeight="96dp"
        android:padding="14dp"
        android:scrollbars="vertical"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_hint"
        android:textSize="14sp" />

    <TextView
        style="@style/SettingsSection"
        android:layout_marginTop="12dp"
        android:text="@string/hotwords_default_title" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="88dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_settings_card"
        android:fillViewport="true"
        android:scrollbars="vertical">

        <TextView
            android:id="@+id/textDefaultHotwordList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:textColor="@color/text_primary"
            android:textIsSelectable="true"
            android:textSize="13sp"
            tools:text="inktalk\nOpenAI\n火山引擎" />
    </ScrollView>

    <Button
        android:id="@+id/btnRestoreHotwords"
        style="@style/SettingsActionButton"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="0dp"
        android:drawableStart="@drawable/ic_material_auto_fix_18"
        android:text="@string/hotwords_restore_defaults" />

    <LinearLayout
        android:id="@+id/btnSaveHotwords"
        style="@style/SettingsPrimaryButton"
        android:clickable="true"
        android:contentDescription="@string/hotwords_save"
        android:focusable="true"
        tools:ignore="UseCompoundDrawables">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_material_save_24"
            android:tint="@android:color/white"
            tools:ignore="UseAppTint" />

        <TextView
            style="@style/SettingsPrimaryButtonLabel"
            android:importantForAccessibility="no"
            android:text="@string/hotwords_save" />
    </LinearLayout>
</com.inktalk.ime.ui.AdaptiveContentLayout>
