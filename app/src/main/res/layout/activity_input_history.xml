<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="18dp"
        android:paddingEnd="20dp"
        android:paddingBottom="48dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="12dp"
                android:src="@mipmap/ic_launcher"
                android:scaleType="centerInside"
                android:contentDescription="@null" />
            <TextView
                style="@style/SettingsHeaderTitle"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="@string/history_title" />
            <TextView
                android:id="@+id/btnHistorySettings"
                android:layout_width="72dp"
                android:layout_height="40dp"
                android:gravity="center"
                android:text="@string/history_settings"
                android:textSize="14sp"
                android:textColor="@color/chip_text"
                android:background="@drawable/bg_action_chip"
                android:contentDescription="@string/history_settings_description" />
        </LinearLayout>

        <TextView
            style="@style/SettingsHeaderSubtitle"
            android:layout_marginTop="4dp"
            android:text="@string/history_scope_description" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="18dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_settings_card">
            <TextView
                android:id="@+id/btnPreviousDate"
                android:layout_width="48dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="@string/history_previous_symbol"
                android:textSize="30sp"
                android:textColor="@color/icon_primary"
                android:contentDescription="@string/history_previous_date" />
            <TextView
                android:id="@+id/textHistoryDate"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:contentDescription="@string/history_choose_date" />
            <TextView
                android:id="@+id/btnNextDate"
                android:layout_width="48dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="@string/history_next_symbol"
                android:textSize="30sp"
                android:textColor="@color/icon_primary"
                android:contentDescription="@string/history_next_date" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnToday"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_gravity="end"
            android:layout_marginTop="8dp"
            android:minWidth="72dp"
            android:gravity="center"
            android:text="@string/history_today"
            android:textSize="13sp"
            android:textColor="@color/chip_text"
            android:background="@drawable/bg_action_chip" />

        <TextView style="@style/SettingsSection" android:text="@string/history_organized_title" />
        <TextView
            style="@style/SettingsSectionDescription"
            android:text="@string/history_organization_privacy" />

        <Button
            android:id="@+id/btnOrganizeDay"
            style="@style/SettingsSecondaryButton"
            android:layout_marginTop="0dp"
            android:text="@string/history_organize"
            android:drawableStart="@drawable/ic_material_auto_awesome_18" />

        <TextView
            android:id="@+id/textHistoryStatus"
            style="@style/SettingsStatus"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/organizedCard"
            style="@style/SettingsCard"
            android:layout_marginTop="12dp"
            android:visibility="gone">
            <TextView
                android:id="@+id/textOrganizationMeta"
                style="@style/SettingsFieldDescription"
                android:layout_marginTop="0dp" />
            <TextView
                android:id="@+id/textOrganizationContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textSize="15sp"
                android:textColor="@color/text_primary"
                android:lineSpacingExtra="4dp"
                android:textIsSelectable="true" />
        </LinearLayout>

        <TextView
            android:id="@+id/textRawHistoryTitle"
            style="@style/SettingsSection"
            android:text="@string/history_raw_title" />
        <TextView
            style="@style/SettingsSectionDescription"
            android:text="@string/history_raw_description" />

        <TextView
            android:id="@+id/textHistoryEmpty"
            style="@style/SettingsHint"
            android:text="@string/history_empty" />

        <LinearLayout
            android:id="@+id/historyEntries"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>
</ScrollView>
